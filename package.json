    "eslint-plugin-react-refresh": "^0.4.19",
    "jsdom": "^26.0.0",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.3.3",
