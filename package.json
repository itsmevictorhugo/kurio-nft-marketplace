{
  "name": "kurio-nft-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/inline-css.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
